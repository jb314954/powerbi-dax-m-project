{
  "name": "2026 Future Glass",
  "dataColors": [
    "#52AEFF",
    "#B3FC58",
    "#FF0051",
    "#A4C7FF",
    "#A8FF9B",
    "#E064FF",
    "#9938F9",
    "#2200FF"
  ],

  "background": "#1F2937",
  "foreground": "#E6E6E7",
  "tableAccent": "#52AEFF",

  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1F2937" } },
            "transparency": 0
          }
        ]
      }
    },

    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1F2937" } },
            "transparency": 10
          }
        ],

        "title": [
          {
            "fontFace": "Segoe UI",
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "labels": [
          {
            "color": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "dataLabels": [
          {
            "color": { "solid": { "color": "#E0E0DA" } }
          }
        ],

        "legend": [
          {
            "labelColor": { "solid": { "color": "#E8EDF1" } },
            "titleColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#9CA3AF" } },
            "titleColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#9CA3AF" } },
            "titleColor": { "solid": { "color": "#E8EDF1" } }
          }
        ]
      }
    },

    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],
        "header": [
          {
            "fontColor": { "solid": { "color": "#E8EDF1" } }
          }
        ]
      }
    },

    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#D5FB00" } }
          }
        ]
      }
    },

    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#EDEFF2" } },
            "backColor": { "solid": { "color": "#1F2937" } }
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#EDEFF2" } }
          }
        ]
      }
    },

    "matrixEx": {
      "*": {
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#EDEFF2" } }
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#EDEFF2" } }
          }
        ]
      }
    }
  }
}
