{
  "name": "2026 Future Glass",
  "dataColors": ["#52AEFF","#B3FC58","#FF0051","#A4C7FF","#A8FF9B","#E064FF","#9938F9","#2200FF"],

  "accent": "#52AEFF",
  "background": "#1F2937",
  "foreground": "#E6E6E7",

  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1F2937" } },
            "transparency": 10
          }
        ]
      }
    },

    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1F2937" } },
            "transparency": 10
          }
        ],

        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#283241" } },
            "radius": 16
          }
        ],

        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 60,
            "shadowBlur": 15
          }
        ],

        "title": [
          {
            "fontFace": "Segoe UI",
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "labels": [
          {
            "color": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "dataLabels": [
          {
            "color": { "solid": { "color": "#E0E0DA" } }
          }
        ],

        "legend": [
          {
            "labelColor": { "solid": { "color": "#E8EDF1" } },
            "titleColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#9CA3AF" } },
            "titleColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],

        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#9CA3AF" } },
            "titleColor": { "solid": { "color": "#E8EDF1" } }
          }
        ]
      }
    },

    "slicer": {
      "*": {
        "items": [
          {
            "background": { "solid": { "color": "#232F3E" } },
            "fontColor": { "solid": { "color": "#E8EDF1" } }
          }
        ],
        "header": [
          {
            "background": { "solid": { "color": "#1F2937" } },
            "fontColor": { "solid": { "color": "#E8EDF1" } }
          }
        ]
      }
    },

    "card": {
      "*": {
        "border": [{ "show": false }],
        "background": [{ "transparency": 100 }],
        "labels": [
          {
            "color": { "solid": { "color": "#D5FB00" } },
            "fontFace": "DIN Bold"
          }
        ]
      }
    },

    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#EDEFF2" } },
            "backColor": { "solid": { "color": "#1F2937" } },
            "fontFace": "DIN Bold",
            "alignment": "Center"
          }
        ],
        "values": [
          {
            "backColorPrimary": { "solid": { "color": "#1F2937" } },
            "fontColorPrimary": { "solid": { "color": "#EDEFF2" } }
          }
        ]
      }
    },

    "matrixEx": {
      "*": {
        "rowHeaders": [
          {
            "fontFace": "DIN Bold",
            "fontSize": 11,
            "fontColor": { "solid": { "color": "#EDEFF2" } },
            "backColor": { "solid": { "color": "#1F2937" } }
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#EDEFF2" } },
            "backColorPrimary": { "solid": { "color": "#1F2937" } }
          }
        ]
      }
    },

    "filterCard": {
      "*": {
        "backgroundColor": { "solid": { "color": "#1F2937" } },
        "foregroundColor": { "solid": { "color": "#E8EDF1" } }
      }
    }
  }
}
